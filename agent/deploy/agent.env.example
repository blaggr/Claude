# Copy to agent.env, fill in, and keep it private:
#   cp agent/deploy/agent.env.example agent/deploy/agent.env && chmod 600 agent/deploy/agent.env
#
# Then either:
#   - source it for tmux:   set -a; source agent/deploy/agent.env; set +a
#   - or point systemd at it: uncomment EnvironmentFile= in trading-agent.service
#
# PAPER only. Do NOT add ALPACA_LIVE here — live needs a separate, deliberate
# interlock (see experiments/live/risk.py).

ALPACA_KEY_ID=PK_your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret

# LLM for reasoning + news classification. Set ONE (OpenAI is preferred if both
# are present); omit both to run the offline heuristic policy.
OPENAI_API_KEY=sk-proj-your_key
OPENAI_MODEL=gpt-4o-mini               # optional; default gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-your_key

# Risk knobs (optional; defaults shown)
EVENT_BUDGET_PCT=10
MAX_DAILY_LOSS_PCT=5
POLL_SECONDS=60
