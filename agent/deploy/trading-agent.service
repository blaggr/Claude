# systemd unit for the always-on agent driver (Linux).
#
# Runs `python -m agent.live_agent` unattended, restarts on crash, and starts on
# boot. PAPER trading only (no ALPACA_LIVE here on purpose).
#
# Install:
#   1. cp agent/deploy/agent.env.example agent/deploy/agent.env, fill it in, chmod 600.
#   2. Edit User, WorkingDirectory, and EnvironmentFile path below.
#   3. sudo cp agent/deploy/trading-agent.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable --now trading-agent
#
# Watch it:        journalctl -u trading-agent -f
# Stop it:         sudo systemctl stop trading-agent
# Kill + flatten:  touch <WorkingDirectory>/experiments/live/KILL   (then stop)
#
# ExecStartPre runs the preflight: the service will NOT start unless the broker
# resolves to Alpaca PAPER (keys present, deps installed) — so a misconfig fails
# fast instead of silently trading a fake local account.

[Unit]
Description=AI trading agent — always-on paper driver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/Claude

# --- secrets: prefer EnvironmentFile (chmod 600) over inline Environment= ---
EnvironmentFile=/home/CHANGE_ME/Claude/agent/deploy/agent.env
# Environment=ALPACA_KEY_ID=PK_CHANGE_ME
# Environment=ALPACA_SECRET_KEY=CHANGE_ME
# Environment=ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Risk knobs (optional; these are the defaults)
Environment=EVENT_BUDGET_PCT=10
Environment=MAX_DAILY_LOSS_PCT=5
Environment=POLL_SECONDS=60

# refuse to start unless the broker resolves to Alpaca PAPER
ExecStartPre=/usr/bin/env bash agent/deploy/run_tmux.sh preflight
ExecStart=/usr/bin/env python3 -m agent.live_agent --interval 60 --budget-pct 10

# auto-restart on crash, but back off so a hard failure doesn't hot-loop
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# stdout/stderr -> journald (view with `journalctl -u trading-agent -f`)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
