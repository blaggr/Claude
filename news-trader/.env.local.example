# news-trader credentials — copy this file to ".env.local" in the SAME directory,
# fill in the values, then lock it down:   chmod 600 .env.local
# .env.local is gitignored and is read by run.sh at launch. Secrets never go in
# the plist or in git.

# Alpaca PAPER keys (app.alpaca.markets -> switch to Paper -> API Keys). Paper only.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Email (SMTP). Use a Gmail App Password, NOT your normal password.
# (myaccount.google.com/apppasswords — requires 2-Step Verification on.)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Optional overrides (defaults shown): SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
