# Required
OPENAI_API_KEY=sk-...
API_BEARER_TOKEN=change-me-to-a-long-random-string

# Optional overrides
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
DATA_DIR=./data
ENABLE_SCHEDULER=true
REINDEX_CRON=0 7 * * 1     # Mondays at 07:00 UTC
MAX_PAGES_PER_DOMAIN=2000
CRAWL_CONCURRENCY=8
CHUNK_TOKENS=600
CHUNK_OVERLAP=80
RETRIEVAL_K=12
RETRIEVAL_FETCH_K=40
